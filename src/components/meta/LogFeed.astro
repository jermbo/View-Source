---
import type { loadLogFeed } from "./logFeed";

interface Props {
	kicker: string;
	heading: string;
	intro: string;
	entries: Awaited<ReturnType<typeof loadLogFeed>>;
}

const { kicker, heading, intro, entries } = Astro.props;
const isEmpty = entries.length === 0;
---

<section class="log">
	<header class="log__header">
		<p class="log__kicker">{kicker}</p>
		<h1>{heading}</h1>
		<p class="log__intro">{intro}</p>
	</header>
	{isEmpty && <p class="log__empty">No entries yet.</p>}
	{
		!isEmpty && (
			<ol class="log__list">
				{entries.map((entry) => (
					<li class="log__entry" id={entry.anchor}>
						<div class="log__meta">
							<time datetime={entry.date.toISOString()}>{entry.dateLabel}</time>
						</div>
						<h2>{entry.title}</h2>
						<div class="log__body">
							<entry.Content />
						</div>
						{entry.nextFocus && (
							<p class="log__next">
								<strong>Next focus:</strong> {entry.nextFocus}
							</p>
						)}
					</li>
				))}
			</ol>
		)
	}
</section>

<style>
	.log {
		grid-column: 1 / -1;
		min-height: 0;
		overflow-y: auto;
		background: var(--surface-hero);
		color: var(--text-on-dark);
		border-radius: var(--radius-panel);
		padding: var(--space-8) var(--space-6);
	}

	.log__kicker {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.6;
		margin: 0 0 var(--space-2);
	}

	.log__header h1 {
		font-family: var(--font-poster);
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		margin: 0 0 var(--space-3);
	}

	.log__intro {
		max-width: 60ch;
		opacity: 0.85;
		margin: 0 0 var(--space-8);
		text-wrap-style: pretty;
	}

	.log__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
	}

	.log__entry {
		border-top: 1px solid color-mix(in srgb, var(--text-on-dark) 20%, transparent);
		padding-top: var(--space-6);
		scroll-margin-top: var(--space-6);
	}

	.log__meta {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 0.6;
		margin-bottom: var(--space-2);
	}

	.log__entry h2 {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1.4rem;
		margin: 0 0 var(--space-4);
	}

	.log__body {
		max-width: 68ch;
		line-height: 1.6;
	}

	.log__body :global(p) {
		margin: 0 0 var(--space-4);
	}

	.log__body :global(h2) {
		font-family: var(--font-heading);
		font-size: 1.1rem;
		margin: var(--space-6) 0 var(--space-2);
	}

	.log__body :global(ul) {
		margin: 0 0 var(--space-4);
		padding-left: var(--space-5);
	}

	.log__body :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: color-mix(in srgb, var(--text-on-dark) 10%, transparent);
		padding: 0.1em 0.35em;
		border-radius: 3px;
	}

	.log__next {
		margin-top: var(--space-4);
		padding-top: var(--space-4);
		border-top: 1px dashed color-mix(in srgb, var(--text-on-dark) 20%, transparent);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		opacity: 0.85;
	}

	.log__empty {
		opacity: 0.6;
	}
</style>
