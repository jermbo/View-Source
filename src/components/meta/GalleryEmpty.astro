---
interface Props {
	message: string;
}

const { message } = Astro.props;
---

<section class="gallery-empty">
	<p class="gallery-empty__message">{message}</p>
</section>

<style>
	.gallery-empty {
		min-height: 0;
		border-radius: var(--radius-panel);
		background: var(--surface-hero);
		color: var(--text-on-dark);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-8);
	}

	.gallery-empty__message {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		letter-spacing: 0.05em;
		text-align: center;
		opacity: 0.6;
	}
</style>
