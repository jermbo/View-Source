---
import "./era2012.css";
import EscapeHatch from "../../../components/EscapeHatch.astro";
import Nav from "./Nav.astro";
import SiteFoot from "./SiteFoot.astro";
import { base } from "./nav";
import { findWorld } from "../../../data/worlds";

interface Props {
	title: string;
	currentHref: string;
	/** Full-viewport hero on the home page, a shorter band on every other page. */
	isLanding?: boolean;
}

const { title, currentHref, isLanding = false } = Astro.props;

const world = findWorld("web-design-eras");
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<div class:list={["hero", !isLanding && "hero--short"]}>
			<span class="hero__credit">bg photo: team at long desk, desaturated</span>
			<header class="masthead">
				<div class="container">
					<div class="masthead__inner">
						<a class="wordmark" href={base}>GLOBEX</a>
						<Nav currentHref={currentHref} />
					</div>
				</div>
			</header>
			<div class="hero__body">
				<slot name="hero" />
			</div>
			{
				isLanding && (
					<div class="scroll-cue">
						<div>Scroll</div>
						<div class="scroll-cue__chevron">&#8964;</div>
					</div>
				)
			}
		</div>
		<main>
			<slot />
		</main>
		<SiteFoot />
		{world && <EscapeHatch world={world} projectSlug="2012-flat" />}
	</body>
</html>
