---
import { navLinks } from "./nav";

interface Props {
	currentHref: string;
}

const { currentHref } = Astro.props;

const items = navLinks.map((item) => ({
	label: item.label,
	href: item.href,
	isLink: Boolean(item.href),
	isCurrent: item.href === currentHref,
}));
---

<nav class="nav">
	{
		items.map((item) => (
			<>
				{item.isLink && (
					<a
						class:list={["nav__item", item.isCurrent && "nav__item--current"]}
						href={item.href}
						aria-current={item.isCurrent ? "page" : undefined}
					>
						{item.label}
					</a>
				)}
				{!item.isLink && <span class="nav__item nav__item--dead">{item.label}</span>}
			</>
		))
	}
	<span class="btn btn--denim" style="margin-left: 10px;">Sign in</span>
</nav>
