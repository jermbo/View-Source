---
import "./era2008.css";
import EscapeHatch from "../../../components/EscapeHatch.astro";
import Brand from "./Brand.astro";
import Nav from "./Nav.astro";
import SiteFoot from "./SiteFoot.astro";
import { findWorld } from "../../../data/worlds";

interface Props {
	title: string;
	currentHref: string;
}

const { title, currentHref } = Astro.props;

const world = findWorld("web-design-eras");
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=980" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<header class="chrome">
			<div class="chrome__inner">
				<Brand />
				<Nav currentHref={currentHref} />
			</div>
		</header>
		<main class="sheet-wrap">
			<div class="sheet">
				<slot />
			</div>
		</main>
		<SiteFoot />
		{world && <EscapeHatch world={world} projectSlug="2008-skeuomorphic" />}
	</body>
</html>
