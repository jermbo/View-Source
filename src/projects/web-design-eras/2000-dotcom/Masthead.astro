---
import { base } from "./nav";
---

<div class="masthead">
	<div class="masthead__brand">
		<a class="masthead__logo" href={base}>NIMBUS SYSTEMS<span class="masthead__logo-suffix">, INC.</span></a>
		<p class="masthead__tagline">&quot;Enterprise Network Solutions for the New Economy&quot;</p>
	</div>
	<div class="masthead__search">
		<span class="masthead__search-label">Search Our Site:</span>
		<div class="masthead__search-row">
			<input class="field" type="text" aria-label="Search our site" />
			<span class="btn btn--small">Go!</span>
		</div>
	</div>
</div>
