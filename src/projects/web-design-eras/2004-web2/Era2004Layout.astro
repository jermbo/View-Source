---
import "./era2004.css";
import EscapeHatch from "../../../components/EscapeHatch.astro";
import Brand from "./Brand.astro";
import Nav from "./Nav.astro";
import SiteFoot from "./SiteFoot.astro";
import { findWorld } from "../../../data/worlds";

interface Props {
	title: string;
	currentHref: string;
}

const { title, currentHref } = Astro.props;

const world = findWorld("web-design-eras");
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=960" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<div class="page">
			<header class="header">
				<div class="header__inner">
					<Brand />
					<Nav currentHref={currentHref} />
				</div>
			</header>
			<main>
				<slot />
			</main>
			<SiteFoot />
		</div>
		{world && <EscapeHatch world={world} projectSlug="2004-web2" />}
	</body>
</html>
