---
import MetaLayout from "../../layouts/MetaLayout.astro";
import LogFeed from "../../components/meta/LogFeed.astro";
import { loadLogFeed } from "../../components/meta/logFeed";

const entries = await loadLogFeed("main");
---

<MetaLayout title="Dev Log · View-Source">
	<LogFeed
		kicker="Dev Log"
		heading="The main site, session by session"
		intro="Every World keeps its own log too. This one is the main site's: the meta layer, the domain model, and the tooling that holds the whole experiment together."
		entries={entries}
	/>
</MetaLayout>
