---
import Era2000Layout from "../../../projects/web-design-eras/2000-dotcom/Era2000Layout.astro";
import { base } from "../../../projects/web-design-eras/2000-dotcom/nav";

const switching = [
	{ model: "GX-4400", description: "Layer-3 Gigabit Switching Chassis, 14 slot", ports: "up to 224", price: "$48,500" },
	{ model: "GX-4200", description: "Layer-3 Gigabit Switching Chassis, 7 slot", ports: "up to 112", price: "$26,900" },
	{ model: "GX-2100e", description: "Managed 24-Port Ethernet Hub", ports: "24", price: "$3,195" },
	{ model: "GX-1000", description: "Unmanaged 12-Port Workgroup Hub", ports: "12", price: "$849" },
];

const software = [
	{ model: "GlobexWare™ 3.0", description: "SNMP Management Console for Windows NT 4.0", ports: "n/a", price: "$11,400" },
	{ model: "GlobexWare™ Agent", description: "Per-node monitoring agent (100 node pack)", ports: "n/a", price: "$2,750" },
];
---

<Era2000Layout
	title="Product Catalog - Globex Systems, Inc. - Networking Hardware, Switches, Hubs, Middleware"
	currentHref={`${base}products/`}
	updated="05/30/2001"
>
	<h1 class="page-heading">Product Catalog</h1>
	<div class="prose">
		<p>
			The Globex product family scales from the wiring closet to the enterprise backbone. All chassis products are
			rack-mountable and ship with GlobexWare&trade; management software. Pricing shown is U.S. list in U.S. dollars and
			is subject to change without notice. Contact an authorized reseller for volume and government pricing.
		</p>
	</div>

	<div class="subhead">SWITCHING &amp; CONNECTIVITY</div>
	<table class="datatable">
		<thead>
			<tr>
				<th>MODEL</th>
				<th>DESCRIPTION</th>
				<th>PORTS</th>
				<th>LIST PRICE</th>
				<th>SPEC</th>
			</tr>
		</thead>
		<tbody>
			{
				switching.map((item) => (
					<tr>
						<td>{item.model}</td>
						<td>{item.description}</td>
						<td>{item.ports}</td>
						<td>{item.price}</td>
						<td>
							<a href={`${base}products/`}>PDF</a>
						</td>
					</tr>
				))
			}
		</tbody>
	</table>

	<div class="subhead">MANAGEMENT SOFTWARE</div>
	<table class="datatable">
		<thead>
			<tr>
				<th>MODEL</th>
				<th>DESCRIPTION</th>
				<th>PORTS</th>
				<th>LIST PRICE</th>
				<th>SPEC</th>
			</tr>
		</thead>
		<tbody>
			{
				software.map((item) => (
					<tr>
						<td>{item.model}</td>
						<td>{item.description}</td>
						<td>{item.ports}</td>
						<td>{item.price}</td>
						<td>
							<a href={`${base}products/`}>PDF</a>
						</td>
					</tr>
				))
			}
		</tbody>
	</table>
	<p class="fineprint">
		Requires Adobe Acrobat Reader 4.0 or higher. Average file size 2.4 MB. GlobexWare&trade; 3.0 requires Windows NT 4.0
		Service Pack 5 or later, 128 MB RAM, and a CD-ROM drive.
	</p>

	<div class="subhead">REQUEST THE CATALOG ON CD-ROM</div>
	<div class="prose">
		<p>
			Prefer a printed catalog? Complete the form below and we will mail you the 2001 Globex Product Catalog on CD-ROM
			within 4 to 6 weeks. Fields marked <span class="required">*</span> are required.
		</p>
	</div>
	<table class="formtable">
		<tbody>
			<tr>
				<th>Full Name <span class="required">*</span></th>
				<td><input class="field" type="text" aria-label="Full name" /></td>
			</tr>
			<tr>
				<th>Company <span class="required">*</span></th>
				<td><input class="field" type="text" aria-label="Company" /></td>
			</tr>
			<tr>
				<th>E-Mail Address <span class="required">*</span></th>
				<td><input class="field" type="text" aria-label="E-mail address" /></td>
			</tr>
			<tr>
				<th>Mailing Address</th>
				<td><textarea class="field" rows="3" aria-label="Mailing address"></textarea></td>
			</tr>
			<tr>
				<th></th>
				<td>
					<span class="btn btn--bold">Submit</span>
					<span class="btn">Reset</span>
				</td>
			</tr>
		</tbody>
	</table>
	<p class="fineprint">
		Your information will not be sold or rented to third parties. Please allow 4-6 weeks for delivery. Offer valid in the
		United States and Canada only.
	</p>
</Era2000Layout>
