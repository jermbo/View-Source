---
import Era2000Layout from "../../../projects/web-design-eras/2000-dotcom/Era2000Layout.astro";
import { base } from "../../../projects/web-design-eras/2000-dotcom/nav";

const productLines = [
	{ model: "NX-4400", description: "Layer-3 Gigabit Switching Chassis" },
	{ model: "NX-2100e", description: "Managed 24-Port Ethernet Hub" },
	{ model: "NimbusWare™ 3.0", description: "SNMP Management Console for Win NT" },
];
---

<Era2000Layout
	title="Nimbus Systems, Inc. - Enterprise Network Solutions"
	currentHref={base}
	updated="06/07/2001"
	showNews
>
	<h1 class="page-heading">Welcome to Nimbus Systems, Inc.</h1>
	<div class="prose">
		<p>
			Nimbus Systems, Inc. is a leading provider of scalable, mission-critical networking hardware and integrated
			middleware solutions for the Fortune 1000 enterprise. Founded in 1997 and headquartered in San Jose, California,
			Nimbus leverages best-of-breed technology partnerships to deliver <b>end-to-end</b> connectivity for the e-business
			marketplace.
		</p>
		<p>
			Please select a department from the navigation menu at left, or <a href={`${base}products/`}>click here</a> to request
			our 2001 Product Catalog on CD-ROM by postal mail.
		</p>
	</div>

	<div class="subhead">PRODUCT LINES</div>
	<table class="datatable">
		<thead>
			<tr>
				<th>MODEL</th>
				<th>DESCRIPTION</th>
				<th>DATA SHEET</th>
			</tr>
		</thead>
		<tbody>
			{
				productLines.map((line) => (
					<tr>
						<td>{line.model}</td>
						<td>{line.description}</td>
						<td>
							<a href={`${base}products/`}>PDF</a>
						</td>
					</tr>
				))
			}
		</tbody>
	</table>
	<p class="fineprint">Requires Adobe Acrobat Reader 4.0 or higher. Average file size 2.4 MB.</p>

	<div class="notice">
		<div class="photo-slot">photo:<br />HQ building</div>
		<p class="notice__text">
			<b>Investor Notice:</b> Nimbus Systems (NASDAQ: NMBS) will report Q2 results on July 18, 2001 at 2:00 PM PDT. A live
			audio webcast will be available in RealPlayer&reg; format. <a href={`${base}about/`}>More information...</a>
		</p>
	</div>
</Era2000Layout>
