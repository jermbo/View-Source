---
import Era2022Layout from "../../../projects/web-design-eras/2022-agent/Era2022Layout.astro";
import { base } from "../../../projects/web-design-eras/2022-agent/nav";

const trace = [
	{ time: "14:02:11", op: "read", opClass: "read", rest: "invoices.q3", detail: "412 rows" },
	{ time: "14:02:12", op: "tool", opClass: "tool", rest: "ledger.reconcile()", detail: "" },
	{ time: "14:02:14", op: "write", opClass: "write", rest: "ledger.adjustments", detail: "+3" },
];

const latencyBars = [34, 52, 41, 68, 58, 88, 72, 46];

const routingTags = ["frontier", "fast", "local", "fine-tuned"];

const complianceChips = ["SOC 2 Type II", "HIPAA", "ISO 27001", "EU residency"];

const production = ["Halden", "Corwin", "Petralux", "nine&co", "Meridian", "Ostara"];
---

<Era2022Layout title="Globex Platform · The data layer your agents run on" currentHref={base} isLanding>
	<Fragment slot="hero">
		<div class="hero__badge"><span class="status-dot"></span> v4 &mdash; agentic runtime, now GA</div>
		<h1 class="headline headline--display hero__title">The data layer<br />your agents run on</h1>
		<p class="hero__sub">
			Globex gives every agent typed access to your company's files, tables and tools &mdash; with permissions,
			traces and rollback built into the primitive.
		</p>
		<div class="hero__actions">
			<span class="btn btn--primary">Start building</span>
			<span class="btn btn--ghost">Read the docs</span>
		</div>
		<div class="install-cmd">
			<span><span class="install-cmd__prompt">$</span> npm i @globex/agent</span>
			<span class="install-cmd__copy">copy</span>
		</div>

		<div class="bento">
			<div class="bento__cell bento__cell--tall">
				<div class="bento__label">01 / Trace</div>
				<div class="bento__title">Every agent action, on the record</div>
				<div class="bento__body">
					Replay any run step by step. See the exact rows read, the tool calls made, and the diff that was written.
				</div>
				<div class="trace">
					{
						trace.map((line) => (
							<div>
								<span class="trace__time">{line.time}</span> <span class:list={["mono", `trace__op--${line.opClass}`]}>{line.op}</span>{" "}
								{line.rest} {line.detail && <span class="trace__detail">{line.detail}</span>}
							</div>
						))
					}
					<div>
						<span class="trace__time">14:02:14</span> <span class="trace__op--halt">halt</span> awaiting approval &mdash;{" "}
						<span class="trace__flag">threshold $25k</span>
					</div>
				</div>
			</div>

			<div class="bento__cell">
				<div class="bento__label">02 / Latency</div>
				<div class="bento__title" style="font-size: 19px;">p99 under 40ms</div>
				<div class="bento__body">Reads land at the edge in 19 regions.</div>
				<div class="barchart">
					{latencyBars.map((height) => <div class="barchart__bar" style={`height: ${height}%;`} />)}
				</div>
			</div>

			<div class="bento__cell">
				<div class="bento__label">03 / Routing</div>
				<div class="bento__title" style="font-size: 19px;">Model-agnostic by default</div>
				<div class="bento__body">Swap providers per task without touching your schema.</div>
				<div class="tag-row">
					{routingTags.map((tag) => <span class="tag">{tag}</span>)}
				</div>
			</div>

			<div class="bento__cell bento__cell--wide">
				<div style="flex: 1; display: flex; flex-direction: column; gap: 11px;">
					<div class="bento__label">04 / Guardrails</div>
					<div class="bento__title">Permissions the agent cannot argue with</div>
					<div class="bento__body" style="max-width: 380px;">
						Row-level policy, spend ceilings and human approval gates, enforced in the runtime rather than the prompt.
					</div>
				</div>
				<div class="compliance-row">
					{complianceChips.map((chip) => <span class="compliance-chip">{chip}</span>)}
				</div>
			</div>
		</div>

		<div class="production-row">
			<div class="production-row__label">In production at</div>
			<div class="production-row__logos">
				{production.map((name) => <span>{name}</span>)}
			</div>
		</div>

		<div class="hero__close">
			<h2 class="hero__close-title">Ship your first agent this afternoon</h2>
			<p class="hero__close-sub">Free through 1M operations a month. No sales call, no procurement, no demo environment.</p>
			<div class="hero__actions">
				<span class="btn btn--primary">Get API key</span>
				<span class="btn btn--ghost">Talk to an engineer</span>
			</div>
		</div>
	</Fragment>
</Era2022Layout>
